{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "source",
    "sha256",
    "strata",
    "pages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "OFFLINE_DEVELOPMENT",
        "LIVE_FEASIBILITY",
        "HELD_OUT"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 6R gold case v1",
  "$defs": {
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_text",
        "text_artifact_sha256",
        "span",
        "region",
        "localization"
      ],
      "properties": {
        "role": {
          "enum": [
            "EQUIPMENT",
            "TAG",
            "LABEL",
            "HEADER",
            "VALUE",
            "UNIT",
            "QUALIFIER",
            "CONTEXT"
          ]
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "localization": {
          "enum": [
            "RESOLVED",
            "VISUAL_REPORTED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "registry_type",
        "tag",
        "tag_state",
        "qualification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "registry_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag_state": {
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNREADABLE",
            "AMBIGUOUS"
          ]
        },
        "qualification": {
          "enum": [
            "INSTALLED",
            "PROPOSED",
            "FUTURE",
            "SPARE",
            "REFERENCE",
            "LEGEND_ONLY",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "equipment_id",
        "attribute_key",
        "raw_label",
        "raw_value",
        "raw_unit",
        "qualifiers",
        "proposed_enum_value",
        "mapping_status",
        "normalized",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "equipment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribute_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "raw_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_enum_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_status": {
          "enum": [
            "MAPPED",
            "UNMAPPED",
            "INVALID"
          ]
        },
        "normalized": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value",
                "unit"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "NUMBER",
                    "INTEGER",
                    "TEXT",
                    "ENUM",
                    "BOOLEAN"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "equipment",
        "attributes"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/equipment"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    }
  }
}
