# Application
APP_NAME=powerforge-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=powerforge
POSTGRES_PASSWORD=powerforge
POSTGRES_DB=powerforge
DATABASE_URL=postgresql+psycopg://powerforge:powerforge@localhost:5432/powerforge

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=powerforge
S3_SECRET_KEY=powerforge_minio
S3_BUCKET=powerforge
S3_REGION=us-east-1
# Endpoint the browser can reach; presigned download URLs are signed against it.
# Leave unset to reuse S3_ENDPOINT_URL. In Docker Compose the API reaches MinIO at
# http://minio:9000, which a browser cannot, so set this to http://localhost:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_SIGNED_URL_EXPIRES_SECONDS=900

# Upload limits (Phase 2)
MAX_UPLOAD_BYTES=262144000
MAX_IMAGE_PIXELS=600000000

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: match MAX_UPLOAD_BYTES so the upload UI can reject oversized files early
# NEXT_PUBLIC_MAX_UPLOAD_BYTES=262144000
API_INTERNAL_URL=http://localhost:8000
