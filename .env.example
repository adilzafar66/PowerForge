# Application
APP_NAME=powerforge-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=powerforge
POSTGRES_PASSWORD=powerforge
POSTGRES_DB=powerforge
DATABASE_URL=postgresql+psycopg://powerforge:powerforge@localhost:5432/powerforge

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=powerforge
S3_SECRET_KEY=powerforge_minio
S3_BUCKET=powerforge
S3_REGION=us-east-1
# Endpoint the browser can reach; presigned download URLs are signed against it.
# Leave unset to reuse S3_ENDPOINT_URL. In Docker Compose the API reaches MinIO at
# http://minio:9000, which a browser cannot, so set this to http://localhost:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_SIGNED_URL_EXPIRES_SECONDS=900

# Upload limits (Phase 2)
MAX_UPLOAD_BYTES=262144000
MAX_IMAGE_PIXELS=600000000
# Document worker rejects a file with more pages than this before rendering.
MAX_PROCESSING_PAGES=1000

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: match MAX_UPLOAD_BYTES so the upload UI can reject oversized files early
# NEXT_PUBLIC_MAX_UPLOAD_BYTES=262144000
API_INTERNAL_URL=http://localhost:8000


# Manual extraction defaults to a synthetic source probe.
EXTRACTION_ENABLED=true
# Enable in API and worker only for explicitly selected OpenAI profiles.
EXTRACTION_EXTERNAL_ENABLED=false
EXTRACTION_MODEL=gpt-6-luna
# Keep OPENAI_API_KEY in worker environment only when external processing is enabled.
EXTRACTION_MAX_PAGES=50
EXTRACTION_MAX_INPUT_BYTES=2000000
EXTRACTION_MAX_IMAGE_PIXELS=20000000
EXTRACTION_MAX_DOCUMENT_BYTES=262144000
EXTRACTION_MAX_OUTPUT_TOKENS=1024
# Production engineering profiles have separately pinned context/output/image bounds.
# The model must support the selected reasoning effort and image detail.
EXTRACTION_ENGINEERING_MAX_OUTPUT_TOKENS=16384
EXTRACTION_ENGINEERING_MAX_TOTAL_INPUT_BYTES=4194304
EXTRACTION_ENGINEERING_MAX_TEXT_CHARS=100000
EXTRACTION_ENGINEERING_MAX_UPSTREAM_BYTES=65536
EXTRACTION_ENGINEERING_IMAGE_DETAIL=high
EXTRACTION_ENGINEERING_REASONING_EFFORT=none
EXTRACTION_MAX_ATTEMPTS=3
# Admission budget includes interrupted and pre-call failed attempts; no hidden SDK retries.
EXTRACTION_MAX_CALLS=150
EXTRACTION_MAX_CONCURRENT_PER_RUN=2
EXTRACTION_MAX_CONCURRENT_GLOBAL=4
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_LEASE_SECONDS=30
EXTRACTION_BACKOFF_SECONDS=5
EXTRACTION_REDISPATCH_SECONDS=30
EXTRACTION_RECOVERY_INTERVAL_SECONDS=15
# Optional: set all three to a reviewed pricing assumption; unset means unknown cost.
# Cached input is conservatively charged at the configured flat input rate in this estimate.
EXTRACTION_PRICING_BASIS=
EXTRACTION_INPUT_USD_PER_MILLION=
EXTRACTION_OUTPUT_USD_PER_MILLION=
